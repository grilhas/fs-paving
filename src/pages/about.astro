---
// Utils
import { getImage, Picture } from "astro:assets";
import { Icon } from "astro-icon/components";

// Components
import BaseLayout from "@layouts/BaseLayout.astro";
import Banner from "@components/Banner/Banner.astro";
import CTASimple from "@components/CTA/CTASimple.astro";
import Reviews from "@components/Reviews/Reviews.astro";

// Data
import { BUSINESS } from "@data/client";

// Images
import bannerImage from "@assets/images/pavimentos/moradias-algarve-acessos.jpg";
import aboutImage1 from "@assets/images/pavimentos/maos-a-assentar-peca.jpg";
import aboutImage2 from "@assets/images/pavimentos/trabalhador-equipamento-seguranca.jpg";
// NOTE: fotografia de banco de imagens com licença livre — é uma imagem genérica de
// obra, não uma fotografia real de quem é dono da empresa. Fica deliberadamente sem
// nome associado (ver o texto abaixo) para não passar por uma pessoa real.
import ownerImage from "@assets/images/pavimentos/medicao-no-local.jpg";

const optimizedBanner = await getImage({ src: bannerImage, format: "webp" });
---

<BaseLayout
  title="Sobre a FS Paving"
  description="A FS Paving assenta calçada portuguesa, pavê e lancis em todo o Algarve, com mais de 18 anos de experiência. Base compactada, pedra assentada à mão e orçamentos gratuitos."
  heroImage={optimizedBanner}
>
  <Banner
    title="Sobre Nós"
    description="Calçada portuguesa, pavê e lancis em todo o Algarve, há mais de 18 anos."
    image={optimizedBanner}
  />

  <!-- ============================================ -->
  <!--             Side By Side Intro               -->
  <!-- ============================================ -->
  <section id="ABoutRPsbs-328">
    <div class="cs-container">
      <!-- Left Image Section -->
      <div class="cs-image-group">
        <Picture
          src={aboutImage1}
          alt="Mãos a assentar peça a peça, com cola e niveladores"
          widths={[482, 802, 1044]}
          sizes="(min-width: 64rem) 522px, (min-width: 48rem) 400px, 90vw"
          formats={["avif", "webp"]}
          pictureAttributes={{ class: "cs-picture cs-picture1" }}
          loading="lazy"
        />
        <Picture
          src={aboutImage2}
          alt="Trabalhador com equipamento de segurança em obra"
          widths={[366, 600, 780]}
          sizes="(min-width: 64rem) 414px, (min-width: 48rem) 300px, 60vw"
          formats={["avif", "webp"]}
          pictureAttributes={{ class: "cs-picture cs-picture2" }}
          loading="lazy"
        />
      </div>
      <!-- Right Content -->
      <div class="cs-content">
        <span class="cs-topper">Sobre Nós</span>
        <h2 class="cs-title">Mais de 18 anos a assentar pedra no Algarve.</h2>
        <p class="cs-text">
          A FS Paving é especialista em pavimentações. Calçada portuguesa, pavê e
          lancis não são um serviço entre muitos: são o que fazemos todos os dias,
          há mais de 18 anos, em todo o Algarve.
        </p>
        <p class="cs-text">
          Essa especialização nota-se onde ninguém olha. Um pavimento em pedra
          quase nunca falha por causa da pedra. Falha porque a base não foi
          compactada em condições, porque a pendente não levou a água para onde
          devia, ou porque a junta ficou vazia e os cubos começaram a mexer. É
          nesses três pontos que se ganha ou perde um pavimento, e é neles que
          não abrimos exceções.
        </p>
        <p class="cs-text">
          Trabalhamos em moradias, condomínios, espaços comerciais e obra pública,
          de Lagos a Faro, incluindo Albufeira, Vilamoura, Loulé e Portimão.
          Atendemos em português, espanhol e alemão, o que ajuda quando o
          proprietário do imóvel não vive em Portugal.
        </p>
        <a href="/contact/" class="cs-button-solid">Pedir Orçamento</a>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!--                   Stats                      -->
  <!-- ============================================ -->
  <div id="AboutStrip-328">
    <ul class="cs-stat-group">
      <li class="cs-item">
        <span class="cs-picture">
          <Icon
            class="cs-icon"
            name="about-call"
            width="33"
            height="33"
            aria-hidden="true"
          />
        </span>
        <div class="cs-flex-group">
          <span class="cs-header">Telefone</span>
          <a href={`tel:${BUSINESS.phoneForTel}`} class="cs-link"
            >{BUSINESS.phoneFormatted}</a
          >
        </div>
      </li>
      <li class="cs-item">
        <span class="cs-picture">
          <Icon
            class="cs-icon"
            name="about-pin"
            width="33"
            height="33"
            aria-hidden="true"
          />
        </span>
        <div class="cs-flex-group">
          <span class="cs-header">Área de Serviço</span>
          <span class="cs-hours">{BUSINESS.address.city} e distrito de {BUSINESS.address.state}</span>
        </div>
      </li>
      <li class="cs-item">
        <span class="cs-picture">
          <Icon
            class="cs-icon"
            name="about-clock"
            width="33"
            height="33"
            aria-hidden="true"
          />
        </span>
        <div class="cs-flex-group">
          <span class="cs-header">Horário</span>
          <span class="cs-hours">{BUSINESS.hours.days[0]} a {BUSINESS.hours.days[BUSINESS.hours.days.length - 1]}</span>
          <span class="cs-hours">{BUSINESS.hours.opens} às {BUSINESS.hours.closes}</span>
        </div>
      </li>
    </ul>
  </div>

  <!-- ============================================ -->
  <!--              Atendimento Direto               -->
  <!-- ============================================ -->
  <section id="Aboutsbs-328">
    <div class="cs-container">
      <Picture
        src={ownerImage}
        alt="Medição e registo no local, antes de dar orçamento"
        widths={[520, 1040]}
        sizes="(min-width: 64rem) 520px, 90vw"
        formats={["avif", "webp"]}
        pictureAttributes={{ class: "cs-picture" }}
        loading="lazy"
      />
      <div class="cs-content">
        <span class="cs-topper">Atendimento Direto</span>
        <h2 class="cs-title">Quem mede o terreno é quem assenta a pedra</h2>
        <p class="cs-text">
          Quando fala com a FS Paving, não fala com um call center. Quem vai ao
          local medir a área e ver o terreno é quem depois assenta a pedra. Por
          isso o orçamento corresponde ao trabalho que é feito, e nada se perde
          entre quem orçamentou e quem apareceu.
        </p>
        <p class="cs-text">
          Isso importa porque cada terreno é diferente. Um pátio com base já
          nivelada não se prepara como um acesso em terra batida, um pavimento por
          onde passam carros todos os dias não leva a mesma base que um caminho de
          jardim, e uma zona à volta de piscina pede pedra que não queime ao sol
          nem escorregue molhada. Dizemos o que a obra exige, mesmo quando é mais
          trabalho do que o cliente esperava ouvir.
        </p>
        <p class="cs-text">
          Orçamentos gratuitos, valores justos e o pavimento entregue com a junta
          cheia e o local limpo. É assim que preferimos ser julgados.
        </p>
        <a class="cs-button-solid" aria-label="pedir orçamento" href="/contact/"
          >Pedir Orçamento</a
        >
      </div>
    </div>
  </section>

  <CTASimple />
  <Reviews />
</BaseLayout>

<style lang="less">
  /*-- -------------------------- -->
<---       Side By Side         -->
<--- -------------------------- -*/

  @media only screen and (min-width: 0rem) {
    #ABoutRPsbs-328 {
      padding: var(--sectionPadding);

      .cs-container {
        width: 100%;
        max-width: (1280/16rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        text-align: left;
        width: 100%;
        max-width: (542/16rem);
        display: flex;
        flex-direction: column;
        align-items: flex-start;
      }

      .cs-text {
        margin-bottom: (16/16rem);
        &:last-of-type {
          margin-bottom: (32/16rem);
        }
      }

      .cs-button-solid {
        margin-top: (8/16rem);
      }

      .cs-image-group {
        font-size: ~"min(2.31vw, .7em)";
        width: (631/16em);
        height: (636/16em);
        position: relative;
      }

      .cs-picture {
        overflow: hidden;
        position: absolute;
        display: block;

        img {
          position: absolute;
          top: 0;
          left: 0;
          height: 100%;
          width: 100%;
          object-fit: cover;
        }
      }

      .cs-picture1 {
        width: (522/16em);
        height: (581/16em);
        left: 0;
        top: 0;
      }

      .cs-picture2 {
        width: (414/16em);
        height: (400/16em);
        background-color: #fff;
        box-shadow: rgba(0, 0, 0, 0.1) 0px 0px 40px;
        border: clamp(0.375em, 1.5vw, 0.75em) solid #fff;
        right: 0;
        bottom: 0;
      }
    }
  }

  @media only screen and (min-width: 64rem) {
    #ABoutRPsbs-328 {
      .cs-container {
        flex-flow: row;
        justify-content: space-between;
        gap: (52/16rem);
      }

      .cs-image-group {
        font-size: ~"min(1.2vw, 1em)";
        flex: none;
      }

      .cs-content {
        margin: 0;
      }
    }
  }

  /*-- -------------------------- -->
<---           Stats            -->
<--- -------------------------- -*/

  @media only screen and (min-width: 0rem) {
    #AboutStrip-328 {
      padding: var(--sectionPadding);
      background-color: var(--primary);

      .cs-stat-group {
        width: 100%;
        max-width: (600/16rem);
        margin: auto;
        padding: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        gap: (40/16rem);
      }

      .cs-item {
        list-style: none;
        width: (290/16rem);
        margin: 0;
        padding: 0;
        display: flex;
        justify-content: flex-start;
        align-items: center;

        &:hover {
          .cs-picture {
            background-color: #fff;
            box-shadow: rgba(149, 157, 165, 0.2) 0px 8px 24px;
            transform: scale(1.05);
          }

          .cs-icon {
            color: var(--primary);
          }
        }
      }

      .cs-picture {
        width: (80/16rem);
        height: (80/16rem);
        margin-right: clamp(0.75rem, 3vw, 1.25rem);
        border-radius: 50%;
        border: 1px solid rgba(255, 255, 255, 0.4);
        display: flex;
        justify-content: center;
        align-items: center;
        flex: none;
        transition:
          background-color 0.3s,
          box-shadow 0.3s,
          transform 0.6s;
      }

      .cs-flex-group {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        flex-direction: column;
      }

      .cs-icon {
        width: (33/16rem);
        height: (33/16rem);
        color: var(--bodyTextColorWhite);
        transition: color 0.3s;
      }

      .cs-header {
        font-size: (20/16rem);
        color: var(--bodyTextColorWhite);
        font-family: var(--headerFont);
        text-transform: uppercase;
        font-weight: 600;
        line-height: 1.2em;
        margin: 0;
        margin-bottom: (12/16rem);
        display: block;
      }

      .cs-link,
      .cs-hours {
        font-size: var(--bodyFontSize);
        line-height: 1.5em;
        font-family: var(--bodyFont);
        text-decoration: none;
        color: #fff;
        text-transform: uppercase;
        display: block;
        transition: color 0.3s;
      }

      .cs-link:hover {
        color: var(--headerColor);
      }
    }
  }

  @media only screen and (min-width: 40.625rem) {
    #AboutStrip-328 {
      .cs-stat-group {
        flex-direction: row;
        flex-wrap: wrap;
        column-gap: (20/16rem);
        row-gap: (32/16rem);
      }
    }
  }

  @media only screen and (min-width: 64rem) {
    #AboutStrip-328 {
      .cs-stat-group {
        max-width: (1280/16rem);
        flex-wrap: nowrap;
        justify-content: space-evenly;
      }
    }
  }

  /*-- -------------------------- -->
<---     Meet The Owner SbS     -->
<--- -------------------------- -*/

  @media only screen and (min-width: 0rem) {
    #Aboutsbs-328 {
      padding: var(--sectionPadding);
      background-color: var(--bgLight);

      .cs-container {
        width: 100%;
        max-width: (550/16rem);
        margin: auto;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        text-align: center;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .cs-text {
        margin-bottom: (16/16rem);
        &:last-of-type {
          margin-bottom: (32/16rem);
        }
      }

      .cs-picture {
        font-size: ~"min(2.16vw, .68em)";
        width: (520/16em);
        height: (520/16em);
        margin: (48/16em) 0;
        position: relative;
        display: block;
        &:before {
          content: "";
          width: 100%;
          height: 100%;
          background: var(--primary);
          opacity: 0.18;
          position: absolute;
          display: block;
          top: 0;
          left: 0;
          transform: rotate(8deg);
        }
        img {
          position: absolute;
          top: 0;
          left: 0;
          height: 100%;
          width: 100%;
          object-fit: cover;
        }
      }
    }
  }

  @media only screen and (min-width: 64rem) {
    #Aboutsbs-328 {
      .cs-container {
        max-width: (1280/16rem);
        flex-direction: row;
        justify-content: center;
        gap: clamp(4.8125rem, 10vw + 1rem, 10rem);
      }

      .cs-content {
        text-align: left;
        align-items: flex-start;
      }

      .cs-picture {
        font-size: ~"min(1.1vw, 1em)";
        margin: (56/16em) 0 (56/16em) (80/16em);
        flex: none;
      }
    }
  }

  /* Dark Mode */
  @media only screen and (min-width: 0rem) {
    body.dark-mode {
      #Aboutsbs-328 {
        background-color: var(--medium);

        .cs-title,
        .cs-text {
          color: var(--bodyTextColorWhite);
        }

        .cs-text {
          opacity: 0.85;
        }

        .cs-picture:before {
          background-color: rgba(255, 255, 255, 0.08);
        }
      }

      #AboutStrip-328 {
        background-color: var(--dark);
      }
    }
  }
</style>
