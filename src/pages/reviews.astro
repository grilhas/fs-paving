---
// Utils
import { getImage } from "astro:assets";

// Components
import BaseLayout from "@layouts/BaseLayout.astro";
import Banner from "@components/Banner/Banner.astro";
import ReviewsSection from "@components/Reviews/Reviews.astro";
import CTA from "@components/CTA/CTASimple.astro";

// Images
import landingImage from "@assets/images/pavimentos/calcada-bicolor.jpg";
const optimizedImage = await getImage({ src: landingImage, format: "webp" });
---

<BaseLayout
	title="Testemunhos | FS Paving"
	description="Testemunhos de clientes da FS Paving em Albufeira, Vilamoura, Loulé, Lagos e no resto do Algarve."
	heroImage={optimizedImage}
>
	<Banner
		title="Testemunhos"
		description="O que dizem os clientes sobre os pavimentos assentados pela FS Paving."
		image={optimizedImage}
	/>
	<ReviewsSection />
	<CTA />
</BaseLayout>
